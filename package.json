{
  "name": "kisnet-ytm-monorepo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/node",
    "packages/native/*"
  ],
  "scripts": {
    "build": "bun run build:node",
    "build:node": "cargo build --locked -p ytm-node && node packages/node/scripts/build.mjs",
    "build:judge": "cargo build --locked -p ytm-node --features judge-fixtures && node packages/node/scripts/build.mjs",
    "build:facade": "node packages/node/scripts/build.mjs --facade-only",
    "build:check": "node scripts/generate-native-packages.mjs --check && node scripts/check-node-build.mjs",
    "rust:fixture-guard": "node scripts/check-release-fixture-guard.mjs",
    "validate": "bun run contracts:check && bun run licenses:check && bun run release:check && bun run validate:node",
    "validate:node": "bun run --filter @sjunepark/ytm validate",
    "test": "bun run test:node",
    "test:node": "bun run build:judge && bun run judge",
    "judge": "node judge/run.mjs --product-root packages/node",
    "judge:broken": "node judge/prove-deliberate-failure.mjs",
    "contracts:check": "node scripts/validate-contracts.mjs && node scripts/generate-native-packages.mjs --check && bun run rust:fixture-guard",
    "licenses:generate": "cargo about generate about.hbs --locked --fail --output-file THIRD_PARTY_LICENSES.html",
    "licenses:check": "node scripts/check-third-party-licenses.mjs",
    "release:check": "node scripts/validate-release.mjs",
    "pack:node": "npm pack --dry-run --workspace packages/node",
    "cli": "node packages/node/dist/cli.js",
    "smoke:node": "node packages/node/dist/cli.js matrix --base-date 2026-06-08 --kind 국채 --format json"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.9.1",
    "yaml": "^2.9.0"
  }
}
