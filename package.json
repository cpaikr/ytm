{
  "name": "kisnet-ytm-monorepo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/node",
    "packages/native/*"
  ],
  "scripts": {
    "build": "bun run build:node && bun run build:cli",
    "build:node": "cargo build --locked -p ytm-node && node packages/node/scripts/build.mjs",
    "build:cli": "cargo build --locked -p ytm-cli",
    "build:judge": "cargo build --locked -p ytm-node -p ytm-cli --features ytm-node/judge-fixtures,ytm-cli/judge-fixtures && node packages/node/scripts/build.mjs",
    "build:sdk": "node packages/node/scripts/build.mjs --sdk-only",
    "build:check": "node scripts/generate-native-packages.mjs --check && node scripts/check-node-build.mjs",
    "rust:fixture-guard": "node scripts/check-release-fixture-guard.mjs",
    "rust:consumer:check": "cargo check --locked --manifest-path tests/rust-sdk-consumer/Cargo.toml",
    "validate": "bun run release:check && node scripts/validate-repository.mjs",
    "validate:python": "node scripts/validate-python.mjs",
    "validate:node": "bun run --filter @sjunepark/ytm validate",
    "test": "bun run test:surfaces",
    "test:surfaces": "bun run build:judge && bun run judge",
    "test:node": "bun run --filter @sjunepark/ytm test",
    "judge": "node judge/run.mjs --product-root packages/node --cli-bin target/debug/ytm",
    "judge:broken": "node judge/prove-deliberate-failure.mjs",
    "contracts:check": "node scripts/validate-contracts.mjs && node scripts/generate-native-packages.mjs --check && bun run rust:fixture-guard",
    "licenses:generate": "node scripts/check-third-party-licenses.mjs --write && node scripts/generate-native-packages.mjs",
    "licenses:check": "node scripts/check-third-party-licenses.mjs",
    "release:version:check": "node scripts/validate-product-version.mjs",
    "release:version:test": "node scripts/test-product-version.mjs",
    "release:cli:test": "node scripts/test-cli-release-artifacts.mjs",
    "release:publication:test": "node scripts/test-release-publication.mjs",
    "release:check": "bun run release:version:check && bun run release:version:test && bun run release:cli:test && bun run release:publication:test && node scripts/validate-release.mjs",
    "pack:node": "npm pack --dry-run --workspace packages/node",
    "cli": "cargo run --locked -p ytm-cli --",
    "smoke:cli": "cargo run --locked -p ytm-cli -- matrix --base-date 2026-06-08 --kind 국채 --format json"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.9.1",
    "yaml": "^2.9.0"
  }
}
