        { "type": "json", "path": "packages/node/package.json", "jsonpath": "$['optionalDependencies']['@sjunepark/ytm-linux-arm64-gnu']" },
        { "type": "json", "path": "packages/node/package.json", "jsonpath": "$['optionalDependencies']['@sjunepark/ytm-linux-x64-gnu']" },
        { "type": "json", "path": "packages/node/package.json", "jsonpath": "$['optionalDependencies']['@sjunepark/ytm-win32-x64-msvc']" },
        { "type": "json", "path": "packages/native/darwin-arm64/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/native/linux-arm64-gnu/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/native/linux-x64-gnu/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/native/win32-x64-msvc/package.json", "jsonpath": "$.version" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/node'].version" },
