        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/node']['optionalDependencies']['@sjunepark/ytm-linux-arm64-gnu']" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/node']['optionalDependencies']['@sjunepark/ytm-linux-x64-gnu']" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/node']['optionalDependencies']['@sjunepark/ytm-win32-x64-msvc']" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/native/darwin-arm64'].version" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/native/linux-arm64-gnu'].version" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/native/linux-x64-gnu'].version" },
        { "type": "yaml", "path": "bun.lock", "jsonpath": "$['workspaces']['packages/native/win32-x64-msvc'].version" }
