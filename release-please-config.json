        { "type": "generic", "path": "crates/ytm-node/Cargo.toml" },
        { "type": "generic", "path": "tests/rust-sdk-consumer/Cargo.toml" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='ytm-cli')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='ytm-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='ytm-node')].version" },
        { "type": "toml", "path": "tests/rust-sdk-consumer/Cargo.lock", "jsonpath": "$.package[?(@.name=='ytm-core')].version" },
        { "type": "json", "path": "packages/node/package.json", "jsonpath": "$.version" },
