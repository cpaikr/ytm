{
  "name": "@sjunepark/ytm",
  "version": "0.2.0",
  "description": "Rust-backed Node SDK for deterministic KIS-NET YTM Matrix lookups.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpaikr/ytm.git",
    "directory": "packages/node"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/native.cjs",
    "dist/native.js",
    "dist/client.d.ts",
    "dist/client.js",
    "skills",
    "CHANGELOG.md",
    "README.md",
    "SPEC.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cargo build --manifest-path ../../Cargo.toml --locked -p ytm-node && node scripts/build.mjs",
    "build:sdk": "node scripts/build.mjs --sdk-only",
    "prepack": "node scripts/build.mjs --sdk-only",
    "prepublishOnly": "node scripts/build.mjs --sdk-only && node ../../judge/run.mjs --product-root . --scenario package-surface",
    "validate": "node ../../judge/run.mjs --product-root . --scenario package-surface",
    "test": "cargo build --manifest-path ../../Cargo.toml --locked -p ytm-node --features judge-fixtures && node scripts/build.mjs && node ../../judge/run.mjs --product-root . --surface node"
  },
  "optionalDependencies": {
    "@sjunepark/ytm-linux-x64-gnu": "0.2.0",
    "@sjunepark/ytm-linux-arm64-gnu": "0.2.0",
    "@sjunepark/ytm-darwin-arm64": "0.2.0",
    "@sjunepark/ytm-win32-x64-msvc": "0.2.0"
  }
}
